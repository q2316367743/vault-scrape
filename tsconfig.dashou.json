{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "$/*": ["src-dashou/core/*"]
    }
  },
  "include": ["src-dashou/**/*.ts", "src/common/**/*.ts"],
  "exclude": ["src-dashou/dashou-dist", "src-dashou/ui", "node_modules"]
}
