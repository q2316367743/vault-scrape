{
  "$schema": "../node_modules/@dashou/cli/schema/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.vault-scrape",
  "name": "刮削",
  "version": "1.0.0",
  "description": "影视库扫描、刮削与播放：本地与远程存储、四类刮削插件、离线数据包与演员资料。",
  "author": {
    "name": "dashou"
  },
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": true,
  "windows": [
    {
      "label": "main",
      "title": "刮削",
      "url": "ui/index.html",
      "width": 1280,
      "height": 860,
      "minWidth": 1040,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "decorations": true,
      "titleBarStyle": "hidden",
      "showOnActivate": true
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "打开刮削",
      "description": "影视库、演员、存储与刮削插件",
      "keywords": [
        "刮削",
        "影视刮削",
        "vault",
        "scrape"
      ],
      "mode": "window",
      "window": "main"
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": [
        "main|play"
      ],
      "permissions": [
        "core:event:allow-listen",
        "core:window:allow-minimize",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-is-maximized",
        "core:window:allow-close",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen"
      ]
    },
    {
      "identifier": "core-base",
      "targets": [
        "core"
      ],
      "permissions": [
        "core:event:allow-emit",
        "core:event:allow-emit-to",
        "core:window:allow-create",
        "core:window:allow-show",
        "core:window:allow-unminimize",
        "core:window:allow-set-focus",
        "core:window:allow-close",
        "core:webview:allow-create-webview",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-open-url"
      ]
    }
  ],
  "csp": "img-src http://127.0.0.1:*; media-src http://127.0.0.1:*; connect-src http://127.0.0.1:*",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  }
}
