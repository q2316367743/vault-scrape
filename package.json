{
  "name": "vault-scrape",
  "version": "1.0.0",
  "description": "影视库扫描、刮削与播放（搭手插件）",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dashou.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.dashou.json",
    "preview": "vite preview",
    "plugin:dev": "dashou-plugin dev",
    "plugin:build": "dashou-plugin build",
    "plugin:build:fast": "dashou-plugin build --no-before-build",
    "postinstall": "patch-package"
  },
  "dependencies": {},
  "devDependencies": {
    "@awo00/smb2": "1.1.1",
    "@dashou/api": "link:../../app/da-shou-plugin-ext/packages/api",
    "@dashou/cli": "link:../../app/da-shou-plugin-ext/packages/cli",
    "@dashou/core": "link:../../app/da-shou-plugin-ext/packages/core",
    "@imengyu/vue3-context-menu": "^1.5.6",
    "@tdesign-vue-next/auto-import-resolver": "^0.1.8",
    "@types/node": "^22.19.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vueuse/core": "^15.0.0",
    "artplayer": "^5.4.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "less": "^4.9.1",
    "patch-package": "^8.0.1",
    "pinia": "^2.3.1",
    "prettier": "^3.7.4",
    "sortablejs": "^1.15.7",
    "tdesign-icons-vue-next": "^0.4.11",
    "tdesign-vue-next": "^1.20.9",
    "typescript": "^5.9.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.6",
    "webdav": "^5.11.0"
  }
}
